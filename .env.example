# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Brave Search API — https://brave.com/search/api — real, free tier (2,000
# queries/month). This is the real discovery engine for LinkedIn/X/Instagram/
# Facebook/Threads/WhatsApp (via site:-restricted search) and for Google
# itself. (Google's own Custom Search JSON API is confirmed closed to new
# customers as of this writing — see app/platforms/web_search.py.)
BRAVE_API_KEY=

# YouTube Data API v3 — enable at
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Optional tuning
PROSPECTA_REQUEST_TIMEOUT=15
PROSPECTA_LLM_TIMEOUT=60
PROSPECTA_MAX_RESULTS_PER_PLATFORM=5
