# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Programmable Search Engine — https://programmablesearchengine.google.com/
# Create a search engine configured to search the entire web, then get its ID
# (cx) from its setup page. The API key is a standard Google Cloud API key with
# the "Custom Search API" enabled: https://console.cloud.google.com/apis/library/customsearch.googleapis.com
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# YouTube Data API v3 — enable at
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# (can reuse the same Google Cloud project/API key as above if that key has
# both APIs enabled)
YOUTUBE_API_KEY=

# Optional tuning
PROSPECTA_REQUEST_TIMEOUT=15
PROSPECTA_LLM_TIMEOUT=60
PROSPECTA_MAX_RESULTS_PER_PLATFORM=5
