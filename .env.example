# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Serper.dev — https://serper.dev — real Google search results, free tier
# (2,500 queries, no credit card). Google's own Custom Search JSON API is
# closed to new customers as of this project's development; see
# app/platforms/search_provider.py for the real finding behind this choice.
SERPER_API_KEY=

# YouTube Data API v3 — enable at
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Optional tuning
PROSPECTA_REQUEST_TIMEOUT=15
PROSPECTA_LLM_TIMEOUT=60
PROSPECTA_MAX_RESULTS_PER_PLATFORM=5
